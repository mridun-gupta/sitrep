# ─────────────────────────────────────────────────────────────────────────
# SITREP configuration — EVERYTHING IS OPTIONAL.
# The app runs fully with zero env vars. Set only what you need.
# Copy to .env.local for development, or set on your host.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase persistence (optional) ──────────────────────────────────────
# Enables cloud watchlist sync + events_cache for the cron ingest.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — required for /api/cron/ingest writes. Never expose client-side.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI situation briefs (optional) ───────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenRouter, OpenAI, Ollama, LM Studio…
# Without these, /api/v1/brief runs in transparent "deterministic" mode.
# AI_BASE_URL=https://openrouter.ai/api/v1      # or http://localhost:11434/v1 for Ollama
# AI_API_KEY=sk-…                                # omit for Ollama
# AI_MODEL=meta-llama/llama-3.1-8b-instruct

# ── Optional keyed sources ────────────────────────────────────────────────
# NEWSAPI_KEY=                       # newsapi.org (free tier)
# ACLED_KEY=                         # acleddata.com (free registration)
# ACLED_EMAIL=you@example.com
# RELIEFWEB_APPNAME=                 # free token — apidoc.reliefweb.int/parameters#appname
# FIRMS_KEY=                         # NASA FIRMS wildfire pixels — firms.modaps.eosdis.nasa.gov/map/activate

# ── Ops ──────────────────────────────────────────────────────────────────
# Enables GET /api/cron/ingest (Bearer-authed). Vercel Cron sends this
# automatically when set — see docs/technical/deployment.md.
# CRON_SECRET=a-long-random-string
# NEXT_PUBLIC_SITE_URL=https://your-deployment.example.com
# NEXT_PUBLIC_BASEMAP_URL=           # override the dark basemap style JSON
